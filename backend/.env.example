NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/woreda_rms
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (nginx, a load balancer…). 0 = none: X-Forwarded-For is ignored.
# Set it correctly in production or the login rate limit sees every user as the proxy's address.
TRUST_PROXY=0
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
ADMIN_EMAIL=admin@rms.local
ADMIN_PASSWORD=ChangeMe123!
